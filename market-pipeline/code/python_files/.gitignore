# Run logs -- stdout redirected to a file during a collector/analysis run.
# Ephemeral by nature (rerun regenerates them); the real durable outputs are
# the *.parquet/*.csv files those runs produce, which stay tracked.
cache_seed/*_log.txt
cache_seed/*_log2.txt
cache_seed/*_log3.txt
cache_seed/*_log4.txt
cache_seed/*_log5.txt
cache_seed/*_log6.txt
cache_seed/*_log7.txt
cache_seed/*_full_log.txt
cache_seed/*_full_log2.txt
cache_seed/*_sequencer_log.txt
cache_seed/*_sequencer_log2.txt

# Smoke-test artifacts -- small-sample dry runs to verify a pipeline works,
# not the real collection. See factorial_screener_test_IN_full.py's own
# module docstring for this convention (SMOKE_OUT_PATH vs OUT_PATH).
cache_seed/*smoketest*.parquet
cache_seed/*SMOKETEST*.parquet

# Daily-generated mailer brief drafts -- regenerated fresh each run, same
# "same-day cache, not durable data" convention CLAUDE.md documents for
# us_list.csv/japan_list.csv/etc. brief_today.html (no draft/action suffix)
# is the one committed, versioned template.
action_brief_today.html
brief_today_draft*.html

# Raw third-party downloads cached locally before being parsed into a
# tracked cache_seed/*.parquet -- same daily-refreshed-cache convention.
docs_cache/

# runtime observability artifacts (obs.py)
logs/

# ── regenerated cache_seed outputs (exception to the rule above) ──
# The convention above is deliberate and stays: cache_seed/*.parquet are durable
# outputs and are versioned. These five are the exception — they are rewritten by
# a named script on essentially every run, so they arrived as binary diffs with
# nothing reviewable in them, and four of the five were sitting dirty in
# `git status` before anyone edited a line.
#
#   data_ledger.parquet              <- data_ledger.py
#   data_sources.parquet             <- source_registry.py
#   data_sufficiency_history.parquet <- data_sufficiency.py
#   india_ccc_screen.parquet         <- build_mailer.py / data_registry.py
#   cleaned_long.parquet             <- bhavcopy_store.py
#
# Listed by name rather than by pattern, so adding a genuinely new seed dataset
# stays tracked by default — the failure mode of a `cache_seed/*.parquet` rule is
# that it silently swallows real seed data later.
#
# Durable copies verified in dropbox:market-data-archive/current/cache_seed on
# 2026-08-15 before untracking; restore any of them with:
#   rclone copy dropbox:market-data-archive/current/cache_seed/<name> cache_seed/
cache_seed/data_ledger.parquet
cache_seed/data_sources.parquet
cache_seed/data_sufficiency_history.parquet
cache_seed/india_ccc_screen.parquet
cache_seed/cleaned_long.parquet

# pytest (tests/ is hermetic; caches are noise)
__pycache__/
.pytest_cache/
